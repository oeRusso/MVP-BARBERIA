# Copiar a .env para desarrollar. Nunca subir el .env real al repositorio.

# Base de datos local (npm run db:up)
DATABASE_URL="mysql://root:barberia_dev@127.0.0.1:3307/barberia"

# Better Auth. Generar el secreto con: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""

# Login de clientes con Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Mercado Pago
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# Emails con Resend (si falta alguno, no se envían)
RESEND_API_KEY=""
EMAIL_FROM=""

# Autoriza el trabajo programado que vence turnos
CRON_SECRET=""

# Contraseña de los usuarios de prueba creados por prisma/seed.ts
SEED_STAFF_PASSWORD=""
